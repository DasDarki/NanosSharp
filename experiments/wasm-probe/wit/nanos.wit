// Minimal slice of the future boundary, modelled as a WIT world.
//
// This formalizes three representative entries of NativeApi
// (NanosSharp/Interop/NativeApi.cs) as a host-imported interface. The interface
// is named `nanos` on purpose: the component canonical ABI lowers a world-level
// `import nanos: interface { ... }` to core wasm imports with module name
// "nanos", which is exactly what `[DllImport("nanos")]` in the guest emits. The
// componentizer (`wasm-component-ld`) matches the two by that name.
//
// Pointers are modelled as bare s32 offsets into the guest's linear memory,
// matching how the real NativeArgument passes strings and handles: raw offsets,
// never shared host pointers. The host reads the bytes out of guest memory.
// This keeps the canonical lowering a plain (i32, i32) with no realloc, so it
// lines up 1:1 with the guest's `[LibraryImport]` signatures.

package nanos:probe@0.1.0;

world sandbox {
    import nanos: interface {
        // NativeApi.Log. Declared as list<u8> so a component host receives the
        // raw bytes directly (the runtime reads them out of guest memory). The
        // canonical lowering is still (ptr: i32, len: i32), identical to the
        // guest's raw `(byte* message, int length)` import - so the guest side
        // does not change, only this type does.
        log: func(message: list<u8>);

        // NativeApi.ValueCreateInteger -> opaque handle (table index)
        value-create-integer: func(value: s64) -> s32;

        // NativeApi.ValueGetInteger
        value-get-integer: func(handle: s32) -> s64;

        // NativeApi.FunctionCall. `arguments` is a packed NativeArgument[] buffer
        // (count-prefixed 32-byte records followed by a scratch blob for strings),
        // mirroring ArgumentPacker. The scalar result stands in for the single
        // NativeArgument the real FunctionCall returns by value.
        function-call: func(method: s32, arguments: list<u8>) -> s64;

        // ManagedCallbacks direction, inverted to guest-pull: the guest pumps
        // events the host (engine) queues. -1 ends the pump. Stands in for
        // Tick/EntityCreated/InvokeFunction delivery into the running runtime.
        next-event: func() -> s32;

        // Trivial call for the chatty-axis benchmark: measures per-crossing
        // overhead of a guest -> host import call.
        nop: func(value: s32) -> s32;
    }
}
