{
  "$schema": "http://json.schemastore.org/template",
  "author": "DasDarki",
  "classifications": ["nanos world", "NanosSharp", "Game"],
  "identity": "NanosSharp.Templates.Assembly",
  "name": "NanosSharp Assembly Package",
  "description": "A nanos world package compiled into an assembly, built into its Server folder.",
  "shortName": "nanossharp-assembly",
  "sourceName": "MyPackage",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "title": {
      "type": "parameter",
      "datatype": "text",
      "description": "Title of the package shown by nanos world.",
      "defaultValue": "My Package",
      "replaces": "PACKAGE_TITLE"
    },
    "packageAuthor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Author of the package.",
      "defaultValue": "Unknown",
      "replaces": "PACKAGE_AUTHOR"
    }
  }
}
