{
  "$schema": "http://json.schemastore.org/template",
  "author": "DasDarki",
  "classifications": ["nanos world", "NanosSharp", "Game"],
  "identity": "NanosSharp.Templates.Assembly",
  "name": "NanosSharp Assembly Package",
  "description": "A nanos world package compiled into an assembly, built into its Server or Client folder.",
  "shortName": "nanossharp-assembly",
  "sourceName": "MyPackage",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "title": {
      "type": "parameter",
      "datatype": "text",
      "description": "Title of the package shown by nanos world.",
      "defaultValue": "My Package",
      "replaces": "PACKAGE_TITLE"
    },
    "packageAuthor": {
      "type": "parameter",
      "datatype": "text",
      "description": "Author of the package.",
      "defaultValue": "Unknown",
      "replaces": "PACKAGE_AUTHOR"
    },
    "side": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Which side the assembly runs on.",
      "defaultValue": "Server",
      "replaces": "SIDE_FOLDER",
      "choices": [
        {
          "choice": "Server",
          "description": "Runs on the server in process with full trust."
        },
        {
          "choice": "Client",
          "description": "Runs on every player inside the WebAssembly sandbox."
        }
      ]
    }
  }
}
