<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MyPackage</RootNamespace>
    <AssemblyName>MyPackage.Scripts</AssemblyName>
    <DefineConstants>$(DefineConstants);CLIENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/MyPackage.Shared.csproj" />
    <None Include="../Package.toml" Link="Package.toml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NanosSharp.Client" Version="NANOSSHARP_VERSION" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="NanosSharp.Core" />
    <Using Include="NanosSharp.Entities" />
    <Using Include="NanosSharp.Enums" />
    <Using Include="NanosSharp.Eventing" />
    <Using Include="NanosSharp.Logging" />
    <Using Include="NanosSharp.Mathematics" />
    <Using Include="NanosSharp.Packages" />
    <Using Include="NanosSharp.Scripting" />
    <Using Include="NanosSharp.Threading" />
    <Using Include="NanosSharp.Diagnostics" />
  </ItemGroup>
</Project>
