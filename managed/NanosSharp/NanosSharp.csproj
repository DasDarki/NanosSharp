<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NanosSharp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanosSharpSide)' == 'Server'">
    <PackageId>NanosSharp</PackageId>
    <Description>.NET scripting API for nanos world servers.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanosSharpSide)' == 'Client'">
    <PackageId>NanosSharp.Client</PackageId>
    <Description>.NET scripting API for nanos world game clients.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanosSharpSide)' == 'Shared'">
    <PackageId>NanosSharp.Shared</PackageId>
    <Description>.NET scripting API shared by nanos world servers and game clients.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated/Server/**;Generated/Client/**;Server/**;Client/**" />
    <Compile Include="Generated/Server/**/*.cs;Server/**/*.cs" Condition="'$(NanosSharpSide)' == 'Server'" />
    <Compile Include="Generated/Client/**/*.cs;Client/**/*.cs" Condition="'$(NanosSharpSide)' == 'Client'" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NanosSharp.Host" />
    <InternalsVisibleTo Include="NanosSharp.Sandbox" />
    <InternalsVisibleTo Include="NanosSharp.Sandbox.Harness" />
    <InternalsVisibleTo Include="NanosSharp.WasmRuntime" Condition="'$(NanosSharpClientRuntime)' == 'Wasm'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="$(RepositoryRoot)/assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
