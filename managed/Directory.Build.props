<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..</RepositoryRoot>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.1.0</Version>
    <Authors>DasDarki</Authors>
    <Copyright>Copyright (c) 2026 DasDarki</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nanossharp.dasdarki.de</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DasDarki/NanosSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nanos-world;nanos;gameserver;scripting;modding</PackageTags>
    <IsPackable>false</IsPackable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(RepositoryRoot)/build/packages</PackageOutputPath>
    <BaseOutputPath>$(RepositoryRoot)/build/managed/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepositoryRoot)/build/managed/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
