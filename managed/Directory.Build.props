<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..</RepositoryRoot>
    <NanosSharpSide Condition="'$(NanosSharpSide)' == '' and ('$(NanosSharpClientRuntime)' == 'Wasm' or '$(NanosSharpClientRuntime)' == 'WasmAot')">Client</NanosSharpSide>
    <NanosSharpSide Condition="'$(NanosSharpSide)' == ''">Server</NanosSharpSide>
    <NanosSharpSideFolder Condition="'$(NanosSharpSide)' != 'Server'">.$(NanosSharpSide)</NanosSharpSideFolder>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.1.0</Version>
    <Authors>DasDarki</Authors>
    <Copyright>Copyright (c) 2026 DasDarki</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nanossharp.dasdarki.de</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DasDarki/NanosSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nanos-world;nanos;gameserver;scripting;modding</PackageTags>
    <IsPackable>false</IsPackable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(RepositoryRoot)/build/packages</PackageOutputPath>
    <BaseOutputPath>$(RepositoryRoot)/build/managed/bin/$(MSBuildProjectName)$(NanosSharpSideFolder)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepositoryRoot)/build/managed/obj/$(MSBuildProjectName)$(NanosSharpSideFolder)/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <NanosSharpSide Condition="'$(NanosSharpSide)' == ''">Server</NanosSharpSide>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanosSharpSide)' == 'Server'">
    <DefineConstants>$(DefineConstants);SERVER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanosSharpSide)' == 'Client'">
    <DefineConstants>$(DefineConstants);CLIENT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanosSharpSide)' != 'Server'">
    <BaseOutputPath>$(RepositoryRoot)/build/managed/$(NanosSharpSide)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepositoryRoot)/build/managed/$(NanosSharpSide)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NanosSharpClientRuntime)' == 'Wasm'">
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);NANOSSHARP_WASM</DefineConstants>
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WasmNativeStrip>false</WasmNativeStrip>
  </PropertyGroup>
  <ItemGroup Condition="'$(NanosSharpClientRuntime)' == 'Wasm'">
    <TrimmerRootAssembly Include="NanosSharp" />
    <TrimmerRootAssembly Include="NanosSharp.WasmRuntime" />
  </ItemGroup>
  <PropertyGroup Condition="'$(NanosSharpClientRuntime)' == 'WasmAot'">
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);NANOSSHARP_WASM</DefineConstants>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IlcExportUnmanagedEntrypoints>true</IlcExportUnmanagedEntrypoints>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmGenerateAppBundle>false</WasmGenerateAppBundle>
  </PropertyGroup>
</Project>
